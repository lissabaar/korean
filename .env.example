# Neon → Connect. DATABASE_URL is the pooled string (host contains -pooler),
# DIRECT_URL is the same string without -pooler; migrations need the direct one.
DATABASE_URL=""
DIRECT_URL=""

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""

# krdict.korean.go.kr → 오픈 API → 인증키 신청
KRDICT_API_KEY=""
# optional fallback dictionary, stdict.korean.go.kr
STDICT_API_KEY=""

# random 32+ bytes: npx auth secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# AI metering. 1 credit = 1 US cent of model cost.
UNLIMITED_AI_EMAILS=""        # comma-separated; the owner's account
FREE_AI_CREDITS="50"          # per new user
AI_DAILY_BUDGET_CREDITS="300" # all free users together, per UTC day

# Optional: "Continue with Google". Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID (Web). Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
